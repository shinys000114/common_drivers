#
# Suspend the system when the TV goes to standby. Optional; enable with
# systemctl enable odroidc5-cec-standby@cec0.service

[Unit]
Description=Suspend when the TV on %I goes to standby
BindsTo=dev-%i.device
Wants=odroidc5-cec@%i.service
After=dev-%i.device odroidc5-cec@%i.service

[Service]
ExecStart=/usr/local/sbin/odroidc5-cec-standby /dev/%I
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
DefaultInstance=cec0
