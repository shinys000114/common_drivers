config AMLOGIC_C5_DISPLAY_RESOURCES
	bool "ODROID-C5 display clock and power resources (experimental)"
	depends on ARCH_MESON_ODROID_COMMON && ARM64 && OF
	depends on PM && COMMON_CLK
	depends on AMLOGIC_COMMON_CLK_S7D
	depends on PM_GENERIC_DOMAINS && AMLOGIC_POWER
	depends on AMLOGIC_RESET_MESON
	depends on AMLOGIC_DRM = n
	depends on !AMLOGIC_HDMITX21 && !AMLOGIC_HDMITX
	depends on !AMLOGIC_HDMITX21_MODERN && !AMLOGIC_HDMITX_MODERN
	depends on !AMLOGIC_VPU && !AMLOGIC_VOUT_CLK_SERVE
	depends on !AMLOGIC_BYPASS_CCF_CLK
	help
	  Provide the HDMI PLL, display clock route and shared analog regmap
	  used by the HDMI PHY. Requires a device tree with the legacy
	  display consumers disabled. This alone does not provide a KMS device.
	  S7D genpd validates firmware errors and state, retains always-on
	  domains, and disables direct power sysfs and legacy SRAM switching.
	  Keep disabled in the original vendor display configuration.

config COMMON_CLK_MESON_S7D_AUDIO
	tristate "Amlogic S7D native audio clocks"
	depends on MFD_MESON_S7D_AUDIO && AMLOGIC_COMMON_CLK
	depends on AMLOGIC_COMMON_CLK_MESON_REGMAP
	depends on AMLOGIC_COMMON_CLK_MESON_SCLK_DIV
	depends on AMLOGIC_COMMON_CLK_MESON_PHASE
	depends on !AMLOGIC_BYPASS_CCF_CLK
	help
	  Provide audio DMA and TDM gates, MCLK generators, the master B
	  bit/sample clocks and the HDMI MCLK route through the audio parent's
	  regmap. Clocks are enabled by their consumers, without global gating.

endmenu
