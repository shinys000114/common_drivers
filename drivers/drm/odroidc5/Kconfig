config AMLOGIC_C5_NATIVE_DISPLAY
	bool "C5 native VPU/HDMI integration (experimental)"
	depends on AMLOGIC_C5_DISPLAY_RESOURCES
	depends on DRM = y && I2C = y && AMLOGIC_CPU_INFO = y
	depends on DMA_CMA
	depends on !AMLOGIC_MEDIA_ENABLE
	select PHY_MESON_S7D_HDMI
	select DRM_KMS_HELPER
	select DRM_GEM_DMA_HELPER
	select DRM_DISPLAY_HELPER
	select DRM_DISPLAY_HDMI_HELPER
	select DRM_BRIDGE_CONNECTOR
	select SND_SOC_HDMI_CODEC if SND_SOC
	help
	  Build the S7D VPU execution path and native RGB8 TMDS bridge, with
	  DRM EDID/SCDC helpers, CCF consumers and generic PHY ownership.
	  Static device trees and built-in drivers only; unbind is suppressed.
	  Register a single CRTC with a linear 32-bit RGB plane and HDMI connector.
	  Requires retained firmware output on S7D revision B, with SDR RGB8 TMDS up to 594 MHz.
	  Do not enable with legacy media/display writers. System sleep supports
	  s2idle after native takeover, retaining the shared display domain.
	  HDMI PCM uses SND_SOC_HDMI_CODEC with SND_SOC_MESON_S7D_HDMI_AUDIO
	  and SND_SOC_ODROIDC5. Deep sleep, hibernation and cold HDMI SRAM
	  initialization are not supported.
