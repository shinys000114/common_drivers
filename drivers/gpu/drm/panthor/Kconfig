config DRM_S7D_PANTHOR
	tristate "Panthor for the S7D Mali-G310 (Linux 6.18 backport)"
	depends on DRM
	depends on ARM || ARM64 || COMPILE_TEST
	depends on !DRM_PANTHOR
	depends on !GENERIC_ATOMIC64
	depends on MMU
	depends on DMA_CMA
	select DEVFREQ_GOV_SIMPLE_ONDEMAND
	select DRM_EXEC
	select DRM_GEM_SHMEM_HELPER
	select DRM_GPUVM
	select DRM_SCHED
	select IOMMU_IO_PGTABLE_LPAE
	select IOMMU_SUPPORT
	select PM_DEVFREQ
	help
	  DRM driver for ARM Mali CSF-based GPUs, forked from Linux 6.18 for
	  the S7D Mali-G310. It can be built beside the vendor kbase driver:
	  the panthor device tree overlay gives the GPU node the compatible
	  Panthor binds to, and without the overlay kbase keeps the GPU.

	  This driver is for Mali (or Immortalis) Valhall Gxxx GPUs.

	  Note that the Mali-G68 and Mali-G78, while Valhall architecture, will
	  be supported with the panfrost driver as they are not CSF GPUs.
