choice
	prompt "ODROID-C5 GPU driver"
	depends on ARCH_MESON_ODROID_COMMON && ARM64 && OF
	default AMLOGIC_C5_GPU_PANTHOR
	help
	  Only one of the two Mali-G310 drivers can be built, as both bind the
	  same GPU node and need different userspace.

config AMLOGIC_C5_GPU_PANTHOR
	bool "Panthor (Mesa)"
	help
	  Allow the S7D Panthor fork (DRM_S7D_PANTHOR) for Mesa's Panfrost
	  and PanVK drivers; the vendor kbase driver is not built.

config AMLOGIC_C5_GPU_KBASE
	bool "ODROID-C5 vendor Mali platform"
	depends on PM && COMMON_CLK
	depends on DRM_PANTHOR = n
	select RESET_CONTROLLER
	help
	  Use the C5 clock, reset and runtime PM consumers with vendor kbase.
	  Preserves the CSF userspace ABI for the matching libMali and firmware.

endchoice
