config VIDEO_AMLOGIC_S7D
	tristate "Amlogic S7D stateful H.264 decoder"
	depends on ARM64 && OF && VIDEO_DEV
	depends on COMMON_CLK && PM && PM_GENERIC_DOMAINS && RESET_CONTROLLER
	depends on DMA_CMA && OF_RESERVED_MEM
	depends on AMLOGIC_TEE && AMLOGIC_OPTEE && !AMLOGIC_MEDIA_ENABLE
	depends on AMLOGIC_S7D_VIDEO_FIRMWARE
	select MFD_SYSCON
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_VMALLOC
	help
	  Standard V4L2 memory-to-memory interface for the S7D VDEC engine.
	  The initial H.264 path uses the Amlogic TEE firmware service,
	  vmalloc input and 32-bit coherent capture buffers on the codec DMA
	  device.

config VIDEO_AMLOGIC_S7D_HEVC_EXPERIMENTAL
	bool "Amlogic S7D experimental HEVC decoder"
	depends on VIDEO_AMLOGIC_S7D
	default n
	select VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	help
	  Register an additional standard V4L2 node for progressive Main 8-bit
	  HEVC up to 1920x1080, with NV12M output and reference-picture reorder.
	  The initial path accepts one independent slice without tiles. Main10,
	  long-term references and dynamic resolution changes are not supported.
	  Hardware validation is incomplete. Leave this disabled for normal
	  H.264-only operation.

config VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	bool

config VIDEO_AMLOGIC_S7D_JPEG_EXPERIMENTAL
	bool "Amlogic S7D experimental JPEG encoder"
	depends on VIDEO_AMLOGIC_S7D
	default n
	help
	  Register an additional standard V4L2 memory-to-memory JPEG encoder.
	  The initial path accepts contiguous progressive NV12/NV21 up to
	  1920x1080 through MMAP buffers and provides baseline 8-bit JPEG with
	  the standard compression quality control. Hardware validation is
	  incomplete. Leave this disabled for normal decoder-only operation.
