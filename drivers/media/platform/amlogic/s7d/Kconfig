config VIDEO_AMLOGIC_S7D
	tristate "Amlogic S7D stateful video decoder"
	depends on ARM64 && OF && VIDEO_DEV
	depends on COMMON_CLK && PM && PM_GENERIC_DOMAINS && RESET_CONTROLLER
	depends on DMA_CMA && OF_RESERVED_MEM
	depends on AMLOGIC_TEE && AMLOGIC_OPTEE && !AMLOGIC_MEDIA_ENABLE
	depends on AMLOGIC_S7D_VIDEO_FIRMWARE
	select MFD_SYSCON
	select V4L2_MEM2MEM_DEV
	select VIDEOBUF2_VMALLOC
	help
	  Standard stateful V4L2 memory-to-memory decoder node for the S7D
	  DOS codec engines. It always decodes H.264 (progressive High
	  profile up to 4096x2304 at 30 frames per second) on the VDEC
	  engine; the options below add codecs on the HEVC engine and the
	  JPEG encoder on HCODEC. The codec firmware is loaded through the
	  Amlogic TEE service. VDEC and HCODEC run one session each, the
	  HEVC engine up to four HEVC, VP9 and AV1 sessions picture by
	  picture, and different engines run at the same time: an H.264
	  decode, decodes on the HEVC engine and a JPEG encode can share the
	  DOS.

config VIDEO_AMLOGIC_S7D_HEVC_EXPERIMENTAL
	bool "Amlogic S7D HEVC decoder"
	depends on VIDEO_AMLOGIC_S7D
	default y
	select VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	help
	  Add HEVC to the S7D video decoder node, decoded on the HEVC engine.
	  It takes progressive Main and Main10 4:2:0 streams up to 4096x2304
	  at 60 frames per second, including resolution changes, and returns
	  8-bit NV12 or NV12M frames or Amlogic FBC frames of the stream's
	  depth, with several slices, tiles, dependent slices, long-term
	  references and temporal sub-layers.

config VIDEO_AMLOGIC_S7D_VP9_EXPERIMENTAL
	bool "Amlogic S7D VP9 decoder"
	depends on VIDEO_AMLOGIC_S7D
	default y
	select VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	help
	  Add VP9 to the S7D video decoder node, decoded on the HEVC engine.
	  It takes profile 0 and profile 2 (8-bit and 10-bit 4:2:0) streams
	  up to 4096x2304 at 60 frames per second, including superframes with
	  hidden, intra-only and show-existing frames, and returns 8-bit NV12
	  or NV12M frames or Amlogic FBC frames of the stream's depth. The
	  frame size, depth and colour may change at a key frame (dynamic
	  resolution change), not between inter frames: reference scaling is
	  not supported.

config VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	bool

config VIDEO_AMLOGIC_S7D_AV1_EXPERIMENTAL
	bool "Amlogic S7D AV1 decoder"
	depends on VIDEO_AMLOGIC_S7D
	default y
	select VIDEO_AMLOGIC_S7D_HEVC_ENGINE
	help
	  Add AV1 to the S7D video decoder node, decoded on the HEVC engine.
	  It takes Main profile 8-bit and 10-bit 4:2:0 OBU streams up to
	  4096x2304 at 60 frames per second, with up to 16 frames in a
	  temporal unit, and returns 8-bit NV12 or NV12M frames or Amlogic
	  FBC frames of the stream's depth. A new sequence header or a key
	  frame of another size, also one below the sequence maximum, changes
	  the resolution dynamically; an inter frame of another size is not
	  supported. Streams with film grain decode, but without the grain:
	  the decoder outputs the picture before grain synthesis, which the
	  vendor applies only at scanout. Super-resolution is not supported.

config VIDEO_AMLOGIC_S7D_JPEG_EXPERIMENTAL
	bool "Amlogic S7D JPEG encoder"
	depends on VIDEO_AMLOGIC_S7D
	default y
	help
	  Register an additional standard V4L2 memory-to-memory JPEG encoder
	  on the HCODEC engine. It takes contiguous NV12 or NV21 frames from
	  16x16 up to 1920x1080 through MMAP or DMABUF buffers and produces
	  baseline 8-bit 4:2:0 JPEG with the standard compression quality
	  control. It runs while the video decoders are decoding.
