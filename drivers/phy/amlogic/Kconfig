config PHY_MESON_S7D_HDMI
	bool "Amlogic S7D HDMI analog PHY"
	depends on AMLOGIC_C5_DISPLAY_RESOURCES
	select GENERIC_PHY
	help
	  Control the HDMI analog lanes through the S7D clock provider regmap,
	  with CCF, reset and runtime PM consumers and firmware trim calibration.
