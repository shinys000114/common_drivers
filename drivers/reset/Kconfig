if RESET_CONTROLLER

config AMLOGIC_RESET_MESON
	tristate "Meson Reset Driver"
	help
	  This enables the reset driver for Amlogic Meson SoCs.

config AMLOGIC_DOS_RESET_MESON
	tristate "Meson Dos Reset Driver"
	help
	  This enables the reset driver for Amlogic Dos Meson SoCs.

config RESET_S7D_VPU
	tristate "Amlogic S7D VPU local resets"
	depends on REGMAP
	help
	  Provide local AFBC and arbiter reset levels through the VPU parent's
	  regmap. Acquiring these reset lines does not change their state.

config RESET_S7D_AUDIO_ARB
	tristate "Amlogic S7D audio memory arbiter reset"
	depends on ARCH_MESON_ODROID_COMMON && OF && COMMON_CLK
	depends on RESET_MESON_AUDIO_ARB=n
	help
	  Reset and enable the audio DDR arbiter ports of the S7D audio
	  block. Forked from the upstream Meson audio arbiter driver.

endif
